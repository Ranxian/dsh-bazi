{
  "name": "dsh-bazi",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 八字模式：四柱排盘、大运流年、神煞与五行统计，按经典典籍逐节论断并用历史事件校准，在 Web 中展示命盘与论断链。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./bazi": "./lib/bazi.js",
    "./engine": "./lib/engine.js",
    "./tables": "./lib/tables.js",
    "./client": "./lib/ui-bazi.client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "references/**/*.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "golden": "node scripts/golden.mjs --random 300",
    "link-deps": "node scripts/link-deps.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
